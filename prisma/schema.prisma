// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Sekolah {
  id                  String   @id @default(uuid())
  namaSekolah         String
  npsn                String   @unique
  emailResmi          String   @unique
  password            String
  namaPenanggungJawab String
  alamatLengkap       String   @db.Text
  kontakSekolah       String

  verificationStatus       String    @default("UNVERIFIED")
  officialNama             String?
  officialSekolahId        String?
  bentukPendidikan         String?
  statusSekolah            String?
  akreditasi               String?
  lastVerifiedAt           DateTime?
  verificationCooldownUntil DateTime?

  daftarSiswa         Siswa[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Siswa {
  id                 String             @id @default(uuid())
  namaLengkap        String
  nis                String             @unique
  kelas              String
  
  // Relasi ke Sekolah yang memverifikasi
  sekolahId          String
  sekolah            Sekolah            @relation(fields: [sekolahId], references: [id], onDelete: Cascade)

  // Status Verifikasi oleh Admin Sekolah
  verificationStatus VerificationStatus @default(PENDING)
  catatanPenolakan   String?            @db.Text

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}
