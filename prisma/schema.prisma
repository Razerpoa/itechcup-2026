// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Sekolah {
  id                  String   @id @default(uuid())
  namaSekolah         String
  npsn                String   @unique
  emailResmi          String   @unique
  password            String   // Hashed password
  namaPenanggungJawab String
  alamatLengkap       String   @db.Text
  kontakSekolah       String

  // Relasi ke data siswa yang mendaftar verifikasi
  daftarSiswa         Siswa[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Siswa {
  id                 String             @id @default(uuid())
  namaLengkap        String
  nis                String             @unique
  kelas              String
  
  // Relasi ke Sekolah yang memverifikasi
  sekolahId          String
  sekolah            Sekolah            @relation(fields: [sekolahId], references: [id], onDelete: Cascade)

  // Status Verifikasi oleh Admin Sekolah
  verificationStatus VerificationStatus @default(PENDING)
  catatanPenolakan   String?            @db.Text

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}
